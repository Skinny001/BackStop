# Copy to .env and fill in before running script/Deploy.s.sol or script/Demo.s.sol.
# Never commit a real .env file or a real private key.

# Deployer / demo-runner key. Must hold Unichain Sepolia ETH for gas (and, for Demo.s.sol,
# enough of CURRENCY0/CURRENCY1 to fund the LP/searcher/victim legs).
PRIVATE_KEY=

# RPC + verification
UNICHAIN_SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# Deploy.s.sol required inputs
CURRENCY0=
CURRENCY1=

# Deploy.s.sol optional inputs (defaults shown)
# POOL_MANAGER=            # leave unset to deploy a fresh PoolManager
# POOL_FEE=3000
# TICK_SPACING=60
# MIN_BOND=10000000000000000000

# Demo.s.sol additional required inputs (paste Deploy.s.sol's console output)
# POOL_MANAGER=
# BACKSTOP_HOOK=
# BACKSTOP_REGISTRY=
# INSURANCE_VAULT=
